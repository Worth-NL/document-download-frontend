{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate DD-Frontend version file",
            "type": "shell",
            "command": "make generate-version-file",
            "problemMatcher": []
        },
        {
            "label": "Install DD-Frontend Python requirements",
            "type": "shell",
            "command": "uv pip sync requirements_nl_test.txt",
            "dependsOn": ["Generate DD-Frontend version file"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Install DD-Frontend local notifynl-utils",
            "type": "shell",
            "command": "CHOICE=$(cat /workspace/.local-editables-choice 2>/dev/null || echo No); if [ \"$CHOICE\" = \"Yes\" ]; then uv pip uninstall notifications-utils && uv pip install -e ../notifynl-utils; fi",
            "dependsOn": ["Install DD-Frontend Python requirements"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Install DD-Frontend local LandRegistry-frontend-jinja",
            "type": "shell",
            "command": "CHOICE=$(cat /workspace/.local-editables-choice 2>/dev/null || echo No); if [ \"$CHOICE\" = \"Yes\" ]; then uv pip uninstall notifynl-frontend-jinja && uv pip install -e ../LandRegistry-frontend-jinja; fi",
            "dependsOn": ["Install DD-Frontend local notifynl-utils"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "NPM DD-Frontend install",
            "type": "shell",
            "command": "npm ci",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "NPM DD-Frontend build",
            "type": "shell",
            "command": "npm run build",
            "dependsOn": ["NPM DD-Frontend install"],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Compile NL requirements",
            "type": "shell",
            "command": "uv pip compile requirements_nl.in -o requirements_nl.txt",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Compile NL test requirements",
            "type": "shell",
            "command": "uv pip compile requirements_nl_test.in -o requirements_nl_test.txt",
            "problemMatcher": [],
            "dependsOn": ["Compile NL requirements"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Vulnerability scan",
            "type": "shell",
            "command": "./scripts/vulnerability-scan.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
